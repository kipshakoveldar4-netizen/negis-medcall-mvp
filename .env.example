# Shared Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias for staff login in environments that expose it to Vite.
SUPABASE_ANON_KEY=

# Frontend (artifacts/negis)
VITE_NEGIS_CONTROL_API_URL=https://admin.negis.online
VITE_API_BASE_URL=

# Backend (artifacts/api-server)
# Required for staff-ready CRM persistence in /api/crm/*
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI/content integrations. If missing, demo fallback stays enabled.
# Оговорка: demo fallback есть только у ТЕКСТА. Генерация изображения и видео
# без ключа не подменяется заготовкой — она отвечает «не подключено» и называет
# недостающую переменную.
OPENAI_API_KEY=
# Текстовая генерация (пакет Meta Ads, сценарии и посты контент-студии) умеет
# двух провайдеров. Умолчание — OpenAI: на счету Anthropic нет средств, и
# ключ без баланса отвечал бы отказом на каждый запрос. Картинки и видео в
# любом случае остаются за OPENAI_API_KEY — Claude их не генерирует.
ANTHROPIC_API_KEY=
# anthropic | openai | auto (умолчание auto = OpenAI, если его ключ задан).
# Чтобы перевести тексты на Claude после пополнения баланса, достаточно
# поставить здесь anthropic — ключ уже заведён. Явно названный провайдер без
# своего ключа не подменяется соседом: это ошибка настройки, и продукт скажет
# о ней словами.
AI_TEXT_PROVIDER=
# Модель Anthropic. Пусто — claude-sonnet-5.
ANTHROPIC_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZOHO_SMTP_PASSWORD=

# Генерация файлов в контент-студии. Тем же OPENAI_API_KEY, что и тексты.
#
# CONTENT_STUDIO_IMAGE_MODEL — необязательна: без неё берётся значение по
# умолчанию. Задавайте, если вашему аккаунту доступна другая модель изображений.
CONTENT_STUDIO_IMAGE_MODEL=
# CONTENT_STUDIO_VIDEO_MODEL — обязательна для видео и намеренно без значения по
# умолчанию: доступ к видеомодели выдаётся аккаунту отдельно, а один ролик стоит
# на порядок дороже картинки. Пока переменная пуста, кнопка генерации видео
# отвечает «не подключено» и ничего не тратит.
CONTENT_STUDIO_VIDEO_MODEL=
# Длительность ролика в секундах. Пусто — используется умолчание провайдера.
CONTENT_STUDIO_VIDEO_SECONDS=

# Значения ниже НЕ ЧИТАЮТСЯ кодом ни в одном месте (проверено grep'ом по
# репозиторию). Они остались от плана вынести озвучку и монтаж внутрь продукта.
# Не покупайте под них ключи ради контент-студии: раздел «Как собирается ролик»
# честно помечает эти шаги как ручные.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HEYGEN_API_KEY=
TAPNOW_API_KEY=

# Meta Marketing API. Secrets stay server-side only.
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_VIDEO_LAUNCH_ENABLED=false # true включает экспериментальный Meta video_id launch для MP4/MOV
# Optional legacy Astana override. Multi-city targeting uses the controlled
# Kazakhstan city list in lib/meta/cities.ts, then in-memory cache, then
# Meta Targeting Search for KZ cities. Do not add one env per city.
META_ASTANA_CITY_KEY=

# TikTok Ads diagnostics foundation. Server-side only: never prefix these with
# VITE_. The current implementation validates read-only access to one advertiser
# account and does not create campaigns, ad groups or ads.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# Server-only provisioning: the one workspace allowed to use this advertiser.
# Required for TikTok diagnostics/setup/connection; never use VITE_ prefix.
TIKTOK_WORKSPACE_ID=
# Optional now; required later for a first-party OAuth connection flow.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Server-only identity, verified against TikTok before dry-run can mark it ready.
TIKTOK_IDENTITY_ID=
# CUSTOMIZED_USER (legacy default), TT_USER or BC_AUTH_TT; AUTH_CODE not supported.
TIKTOK_IDENTITY_TYPE=
# Required only for BC_AUTH_TT. Never returned to the browser.
TIKTOK_IDENTITY_AUTHORIZED_BC_ID=

# Large video optimization pipeline (Phase A). Off by default: nothing changes
# until VIDEO_OPTIMIZATION_ENABLED=true. Videos above the threshold go to the
# private ad-creatives-raw bucket and a video_processing_jobs row (migration 016);
# the ffmpeg worker (Phase B) publishes the optimized MP4 back to ad-creatives.
VIDEO_OPTIMIZATION_ENABLED=false
VIDEO_OPTIMIZATION_THRESHOLD_MB=50
VIDEO_OPTIMIZATION_MAX_INPUT_MB=500
VIDEO_OPTIMIZATION_RAW_BUCKET=ad-creatives-raw
VIDEO_OPTIMIZATION_WORKER_SECRET=

# Video optimization worker (artifacts/video-worker, deployed on Railway).
# Needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY in the worker environment.
# See docs/VIDEO-WORKER.md. All values below are worker-side defaults.
VIDEO_WORKER_POLL_INTERVAL_MS=5000
VIDEO_WORKER_ID=
VIDEO_WORKER_MAX_ATTEMPTS=3
VIDEO_WORKER_TMP_DIR=/tmp
VIDEO_WORKER_CRF=23
VIDEO_WORKER_PRESET=medium
VIDEO_WORKER_MAX_WIDTH=1080
VIDEO_WORKER_MAX_HEIGHT=1920
VIDEO_WORKER_FPS=30

# Meta Insights background cycle (CRM11e.2). Server-side secrets — these live only
# on the Vercel deployment and gate POST /api/crm/meta-insights-background-cycle.
# Without META_INSIGHTS_WORKER_SECRET the endpoint rejects every request.
META_INSIGHTS_WORKER_SECRET=

# Владельцы ПЛАТФОРМЫ Medina: идентификаторы пользователей Supabase Auth через
# запятую. Это единственный пропуск к панели со списком всех клиник и выручкой.
#
# Не роль: роли живут в staff_users и назначаются владельцем КЛИНИКИ — значит
# роль «владелец платформы» он рано или поздно назначит себе. Этот список правит
# только тот, у кого есть доступ к настройкам развёртывания.
#
# Пусто — панель выключена и отвечает 404 всем, включая вас. Значения, не
# похожие на идентификатор, отбрасываются молча: заготовка в этом файле не
# должна становиться пропуском.
MEDINA_PLATFORM_OWNER_IDS=

# Источники портала Medina Control (artifacts/medina-control), через запятую:
# полные origin вида https://control-host.vercel.app без пути и слэша.
# Пусто — CORS выключен и API отвечает только своему домену, как раньше.
MEDINA_CONTROL_ORIGINS=
META_INSIGHTS_WORKSPACE_ALLOWLIST=
META_INSIGHTS_WORKER_MAX_CLOCK_SKEW_SECONDS=300

# Meta Insights background worker (artifacts/meta-insights-worker, Railway Cron).
# Worker-side only. It holds ONLY the shared worker secret — never the Meta token,
# Meta app secret, or Supabase service-role key. See the package README.
NEGIS_API_BASE_URL=
META_INSIGHTS_WORKSPACE_IDS=
META_INSIGHTS_WORKER_ID=
META_INSIGHTS_MAX_LAUNCHES=2
META_INSIGHTS_REQUEST_TIMEOUT_MS=60000

# MedCall Targeting Agent proxy (root Vercel API routes)
TARGETING_AGENT_URL=http://localhost:3001
TARGETING_AGENT_API_KEY=

# Local Vite dev server port for `pnpm --filter @workspace/negis run dev`
PORT=3000

# Optional smoke-test base URL for `pnpm run test:targeting`
NEGIS_TARGETING_PROXY_URL=http://localhost:3000

# Optional smoke-test base URL for `pnpm run test:routes`
NEGIS_SMOKE_BASE_URL=http://localhost:3000

# Wazzup inbound webhook (WhatsApp → CRM leads). Values live only in Vercel env.
# WAZZUP_WEBHOOK_SECRET authenticates incoming webhooks (?secret= in webhooksUri).
# WAZZUP_API_KEY is used by the owner to subscribe webhooks (and later, phase 2 outbound).
WAZZUP_WEBHOOK_SECRET=your-webhook-secret
WAZZUP_API_KEY=your-wazzup-api-key

# WhatsApp Cloud API inbound webhook (§14 phase 2, api/webhooks/whatsapp).
# WHATSAPP_APP_SECRET verifies X-Hub-Signature-256 over the raw request body.
# WHATSAPP_VERIFY_TOKEN answers Meta's subscription handshake (hub.challenge).
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Пуш-уведомления сотрудникам (web push, RFC 8291).
# Пару ключей печатает `pnpm --filter @workspace/scripts run vapid:keys` — один
# раз, и значения живут только в переменных окружения Vercel. В репозиторий они
# не попадают: здесь и должны стоять плейсхолдеры.
NEGIS_VAPID_PUBLIC_KEY=
NEGIS_VAPID_PRIVATE_KEY=
NEGIS_VAPID_SUBJECT=mailto:owner@example.com
