{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.cjs",
    "build": "node scripts/run-pnpm.cjs run typecheck && node scripts/run-pnpm.cjs --filter @workspace/negis run build",
    "build:all": "node scripts/run-pnpm.cjs run typecheck && node scripts/run-pnpm.cjs -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck": "node scripts/run-pnpm.cjs run typecheck:libs && node scripts/run-pnpm.cjs run typecheck:api && node scripts/run-pnpm.cjs -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:mobile": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:mobile",
    "test:insights-completeness": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:insights-completeness",
    "test:meta-insights-worker": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:meta-insights-worker",
    "test:dashboard": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:dashboard",
    "test:commercial": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:commercial",
    "test:onboarding": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:onboarding",
    "test:security1a": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:security1a",
    "test:security1b": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:security1b",
    "test:routes": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:routes",
    "test:targeting": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:targeting",
    "test:meta-launch-payload": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:meta-launch-payload",
    "test:crm-auth-foundation": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:crm-auth-foundation",
    "test:legacy-webhook": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:legacy-webhook",
    "test:tenant-isolation": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:tenant-isolation",
    "test:api-surface-authorization": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:api-surface-authorization",
    "test:staff-invitations": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:staff-invitations",
    "test:storage-isolation": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:storage-isolation",
    "test:workspace-selection": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:workspace-selection",
    "test:failure-honesty": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:failure-honesty",
    "test:migration-chain": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:migration-chain",
    "test:wazzup-webhook": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:wazzup-webhook",
    "test:transition-performance": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:transition-performance",
    "test:whatsapp-cloud-webhook": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:whatsapp-cloud-webhook",
    "test:crm-phone-parity": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:crm-phone-parity",
    "test:whatsapp-channels": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:whatsapp-channels",
    "test:design-tokens": "node scripts/run-pnpm.cjs --filter @workspace/scripts run test:design-tokens"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/node": "^5.8.17"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
